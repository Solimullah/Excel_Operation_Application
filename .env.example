# ---------------------------------------------------------------------------
# ExcelFile Operations — environment template
#
# Copy to .env.local for local development:   cp .env.example .env.local
# .env.local is gitignored. NEVER commit real values.
# ---------------------------------------------------------------------------

# !! READ THIS BEFORE ADDING A VARIABLE !!
#
# Vite inlines every VITE_* variable into the client bundle at BUILD time.
# Anything here is PUBLIC — visible to anyone who opens devtools.
#
#   - There is NO server in this project, so there is no such thing as a
#     "server-side secret" here.
#   - NEVER put an API key, token, password or connection string in this file
#     or any .env file in this repository.
#   - A variable without the VITE_ prefix is not exposed to the app at all.
#
# See context/system-rules.md §1 and §5.

# Application ------------------------------------------------------------
# Shown in the UI and the browser title.
VITE_APP_NAME="ExcelFile Operations"

# Base public path. "/" for a root deploy; "/subfolder/" behind a path prefix.
VITE_BASE_PATH="/"

# Behaviour --------------------------------------------------------------
# Rows rendered in the Data View preview. Exports are never limited by this.
VITE_PREVIEW_ROW_LIMIT="100"

# Rows plotted in the Visualizations tab.
VITE_CHART_ROW_LIMIT="20"

# Warn when an uploaded file exceeds this size, in megabytes. Empty = no warning.
VITE_LARGE_FILE_WARN_MB="25"

# Diagnostics ------------------------------------------------------------
# Console log level: silent | error | warn | info | debug
# Defaults to "debug" in dev and "error" in production builds.
VITE_LOG_LEVEL="debug"
